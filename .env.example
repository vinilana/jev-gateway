# --- Required: a key for Jev -------------------------------------------------
# Jev makes the tool-selection call. The launchers (jev-codex, jev-claude, ...) ask for this on
# first run and save it to ~/.jev-gateway/.env, so you only need this file for a standalone server.
# Set ONE of the four. JEV_PROVIDER picks when several are set (default: the first one present).
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# OPENCODE_API_KEY=
# JEV_PROVIDER=typesafe   # typesafe | openrouter | vercel | opencode

# --- Upstream LLM (any OpenAI-compatible API) -------------------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
# If set, replaces the client's Authorization header on upstream requests.
# If unset, the client's own Authorization header is forwarded as-is.
UPSTREAM_API_KEY=
# If set, clients must send "Authorization: Bearer <ROUTER_API_KEY>" (requires UPSTREAM_API_KEY).
ROUTER_API_KEY=
# Optional cheaper model used only to fill arguments once Jev has picked the tool; ignored for Gemini.
ARGS_MODEL=

# --- Routing ----------------------------------------------------------------
PORT=8787
# Interface to listen on. Keep loopback unless other machines must reach the gateway (then set ROUTER_API_KEY).
HOST=127.0.0.1
# Defaults to the provider's own Jev model (jev-latest, typesafe/jev-1.14, typesafe-ai/jev, jev-1.13-free).
# On TypeSafe, jev-latest is Jev 1.13 until TypeSafe moves it; JEV_MODEL=jev-1.14.0 picks 1.14 now.
# OpenCode defaults to free jev-1.13-free. To opt into paid jev-1.13, set JEV_MODEL=jev-1.13.
# If the free model is unavailable, the request goes to the LLM unchanged.
# JEV_MODEL=
JEV_TIMEOUT_MS=4000
# Below this confidence the request is forwarded untouched (the LLM decides).
JEV_MIN_CONFIDENCE=0.7
# Minimum certainty per closed-set argument before answering without the LLM.
JEV_ARG_MIN_CERTAINTY=0.8
# When Jev says "no tool needed": force_none (tool_choice=none) | passthrough.
# Unset, the default depends on JEV_CLIENT: passthrough for codex, force_none for every other client.
# A value set here wins for all of them.
JEV_ON_NONE=
# Answer directly (no LLM call) for closed-set arguments where supported.
# Gemini never synthesizes tool calls; when Jev selects a function, Google generates it in forced mode.
JEV_DIRECT_CALLS=true
# off starts the gateway as a plain metering proxy (baseline for token comparisons).
# Can be flipped at runtime from the dashboard or with `jev-codex --routing on|off`.
JEV_ROUTING=on
# Ask Jev beside each request and log what it would do (`shadow`), without applying it: the original
# request is forwarded at once, so Jev adds no latency. It is still billed. Routing off and
# `x-jev-gateway: off` still skip Jev. /router/decide ignores this. Requires a gateway restart.
JEV_SHADOW=false
JEV_MAX_STATE_CHARS=60000
# State limits count serialized JSON UTF-16 units, including metadata; integer minimum 64.
JEV_MAX_MESSAGE_CHARS=4000
# Per-field text limit; positive integer. Ordinary clipping does not bypass routing.
# Inline PNG and JPEG images Jev sees beside the conversation, newest first. Each one also takes room
# from the state budget. 0 keeps every image a placeholder, as before Jev read images.
JEV_MAX_IMAGES=2

# --- Debugging --------------------------------------------------------------
# Opt-in wire dumps: every routed request (decoded JSON body, credentials redacted), what the
# router changed, and the reply's usage / error body. Dumps contain the whole conversation.
JEV_DEBUG_DUMP_DIR=

# --- Dashboard (GET /dashboard) ---------------------------------------------
# Label for this router's traffic; the jev-codex / jev-claude launchers set it.
# The value codex also changes the default of JEV_ON_NONE (see above).
JEV_CLIENT=standalone
# JSON-lines file this server's stdout is appended to (e.g. `pnpm start >> router.log`): read once
# at startup so the dashboard's history survives restarts. The launchers set it.
JEV_LOG_FILE=

# --- Antigravity CLI launcher -----------------------------------------------
# Optional overrides for jev-antigravity / jev-agy; see the README for provider detection.
# JEV_ANTIGRAVITY_PORT=8795
# JEV_ANTIGRAVITY_UPSTREAM_BASE_URL=
